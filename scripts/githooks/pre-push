#!/bin/sh
# 推送前在本机跑这次改动涉及的检查（docs/development.md）：
# 文档引用检查（每次都跑）；命令行的 ruff、格式、mypy、pytest 和入口；GUI 的类型检查和不开窗口的单元测试；
# 改了打包相关的文件时再打包一次命令行工具。
# 开窗口的端到端测试（e2e、update），和会安装程序、改真实 PATH 或已安装程序的测试（update-install、installer-path）只在 GitHub 上跑。失败时以非 0 退出，挡下这次推送。
cd "$(git rev-parse --show-toplevel)" || exit 1
fail() { echo "pre-push：$1 失败，不推送" >&2; exit 1; }
refs=$(cat)

# 推送的提交都已在远端某个分支上时，已经检查过，不再重跑。
zero=0000000000000000000000000000000000000000
new=no
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "$local_sha" ] && [ "$local_sha" != "$zero" ] || continue
  [ -n "$(git rev-list "$local_sha" --not --remotes 2>/dev/null | head -1)" ] && new=yes
done <<EOF_REFS
$refs
EOF_REFS
if [ "$new" = no ]; then
  echo "pre-push：没有新提交（都已在远端分支上），跳过本机检查" >&2
  exit 0
fi

# 需求、PRM、ADR、不变量编号和相对链接都要存在。只用 Python 自带的模块，一秒内跑完，只改文档时也跑。
uv run --no-project --quiet python scripts/verify_doc_references.py >/dev/null 2>&1 ||
  fail "文档引用检查（uv run --no-project python scripts/verify_doc_references.py 看详情）"

# 和 GitHub 一样按改动挑其余的检查（.github/scripts/changed-jobs.sh）：只改文档时不再跑别的。基准和 GitHub 不同：
# 远端已有的分支只看这次新推的提交（远端那一版之后的），之前的提交推送时已经查过；新分支、远端那一版不在本机或
# 不是这次的祖先（强制推送）时，看整个分支相对 main 的改动。GitHub 总看整个分支，因为后一次推送会取消前一次运行。
cli=false gui=false installer=false packaging=no
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac   # 标签不另外检查
  [ "$local_sha" = "$zero" ] && continue                       # 删分支
  if [ "$remote_sha" != "$zero" ] && git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    base=$remote_sha
  else
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null)
  fi
  picked=$(bash .github/scripts/changed-jobs.sh "$base" "$local_sha" 2>/dev/null) || picked='cli=true gui=true installer=true'
  case "$picked" in *cli=true*) cli=true ;; esac
  case "$picked" in *gui=true*) gui=true ;; esac
  case "$picked" in *installer=true*)
    installer=true
    if [ -n "$base" ] && git diff --name-only "$base" "$local_sha" | grep -q -E '^(packaging/|gui/package\.json|\.github/(workflows/test\.yml|actions/))'; then
      packaging=yes
    fi
    ;;
  esac
done <<EOF_REFS
$refs
EOF_REFS
echo "pre-push：按改动要跑的检查 cli=$cli gui=$gui installer=$installer" >&2
logs=$(mktemp -d)
start=$(date +%s)
if [ "$cli" = true ]; then
  ( uv run ruff check src tests && uv run ruff format --check src tests && uv run mypy && uv run pytest -q && uvx --from . video-agent --help ) \
    >"$logs/cli.log" 2>&1 &
  cli_pid=$!
fi
if [ "$gui" = true ]; then
  ( cd gui && npm run typecheck --silent && node --test --test-concurrency=1 $(ls test/*.test.js | grep -v -E '/(e2e|update|update-install|installer-path)\.test\.js$') ) >"$logs/gui.log" 2>&1 &
  gui_pid=$!
fi
if [ -n "${cli_pid:-}" ] && ! wait "$cli_pid"; then tail -30 "$logs/cli.log" >&2; fail "命令行检查（ruff、pytest；日志在 $logs/cli.log）"; fi
if [ -n "${gui_pid:-}" ] && ! wait "$gui_pid"; then grep -E "^✖|error TS|Error|expected|actual" "$logs/gui.log" | head -30 >&2; fail "GUI 测试（日志在 $logs/gui.log）"; fi
[ -n "${cli_pid:-}${gui_pid:-}" ] && echo "pre-push：测试通过，用了 $(( $(date +%s) - start )) 秒" >&2
rm -rf "$logs"
if [ "$packaging" = yes ]; then
  bash packaging/ffmpeg/fetch.sh >/dev/null 2>&1
  case $? in
    0)
      echo "pre-push：改了打包相关的文件，本机打包命令行工具并跑冒烟测试（约 2 分钟）" >&2
      uv run --with pyinstaller --with pillow python packaging/build_cli.py >/dev/null 2>&1 || fail "打包冒烟测试（uv run --with pyinstaller --with pillow python packaging/build_cli.py 看详情）"
      ;;
    # build.sh 改了：新的 FFmpeg 由 GitHub 编译，之后再换上预编译包（docs/development.md「构建」）。
    2) echo "pre-push：build.sh 改了，还没有对应的预编译 FFmpeg，跳过本机打包冒烟测试，由 GitHub 编译并打包" >&2 ;;
    *) fail "准备并校验 LGPL FFmpeg（bash packaging/ffmpeg/fetch.sh 看详情）" ;;
  esac
fi
echo "pre-push：本地检查通过。" >&2
